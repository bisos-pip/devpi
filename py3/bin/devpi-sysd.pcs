""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.devpi/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
The devpi.service unit: devpi-server (with devpi-web) from its isolated venv, flags from ARGS in
/etc/default/devpi expanded as separate words ($ARGS). devpi-server is a WSGI app with its own
server (waitress); nginx is the reverse proxy in front of it.
#+end_org """

from bisos.debian import systemd_seedInfo
from bisos.debian import systemd_seed as systemd_seed  # noqa

from bisos.devpi.devpiInfo import devpiInfo, sysdServiceLines

def sysdUnitFileFunc() -> str | None:
    """Produce the unit file as a string."""

    if not ( execPath := devpiInfo.venvBin("devpi-server") ).exists():
        return None

    templateStr = f"""
[Unit]
Description=devpi-server (Python package index, with devpi-web)
After=network.target

[Service]
Type=simple
{sysdServiceLines(devpiInfo.envFile)}ExecStart={execPath} $ARGS
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
"""
    return templateStr

systemd_seedInfo.setup(
    seedType="sysdSysUnit",
    sysdUnitName="devpi",
    sysdUnitFileFunc=sysdUnitFileFunc,
)
