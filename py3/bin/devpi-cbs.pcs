#!/usr/bin/env python

""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.devpi/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
devpi-cbs.pcs
cbs: Capability Bundle Specification  -- Based on a cba-sysd.cs seed
ws: An Web Service  --- /Service Component/ --- devpi as devpi.internal
n:  No Data    -- Materialization is purely based on Realm-BPO
p:  Platform    -- Materialization is based on Platform-BPO (Site-BPO is not used)

The bundle: devpiCbs-sbom.pcs, which runs devpi-sbom.pcs (account, devpi in its isolated venv,
config, devpi-init) and devpiUsage-sbom.pcs (devpi-client); the devpi and devpi-accounts units; and
devpi-assemble.cs (devpi.internal dns + nginx vhost).
cba_seed takes one sbom, hence devpiCbs-sbom.pcs rather than both names here.
#+end_org """

from bisos.capability import cba_sysd_seed
from bisos.capability import cba_seed

cba_seed.setup(
    seedType="systemd",  # Extend using cba_sysd_seed.setup
    loader=None,
    sbom="devpiCbs-sbom.pcs",
    assemble="devpi-assemble.cs",
    materialize=None,
)

# The server first, then the oneshot that creates the admin user and its index through it.
sysdUnitsListDevpi = [
    cba_sysd_seed.sysdUnit("devpi",           "devpi-sysd.pcs"),
    cba_sysd_seed.sysdUnit("devpi-accounts",  "devpi-accounts-sysd.pcs"),
]

cba_sysd_seed.setup(
    sysdUnitsList=sysdUnitsListDevpi,
)

cba_sysd_seed.plantWithWhich("cba-sysd.cs")
