#!/usr/bin/env python

""" #+begin_org
* ~[Summary]~ :: A =PlantedCmndService= for devpi.here NGINX virtual-host (capWebVd) --- fronts devpi-server and devpi-web
#+end_org """

from bisos.b import cs
import collections

from bisos.csSeed import seedsLib

from bisos.webCap import capWebVd_seed  # noqa: F401  # _atExit_

from bisos.webCap import capWebVd_seedInfo
from bisos.devpi.devpiInfo import devpiInfo

serverName = devpiInfo.fqdn
# devpi-server binds devpiInfo.listenIp (loopback) only; nginx proxies to that address.
proxyIp = devpiInfo.listenIp
proxyPort = devpiInfo.portNu

def wvdConfigFunc() -> str:
    """A reverse proxy to devpi-server on loopback.

    client_max_body_size: nginx's default of 1m would refuse most uploads. devpi-server builds its
    links from --outside-url (http://devpi.here), so no header rewriting is needed.
    """
    return f"""\
server {{
    listen 80;
    server_name {serverName};
    client_max_body_size 200m;

    location / {{
        proxy_pass http://{proxyIp}:{proxyPort};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }}
}}
"""

capWebVd_seedInfo.setup(
    serverName=serverName,
    proxyPort=proxyPort,
    wvdConfigFunc=wvdConfigFunc,
)

from bisos.csSeed import csCmndsList_seedInfo
csCmnd = csCmndsList_seedInfo.csCmnd

csCmndsList = [
    csCmnd("configFileStdout", pars={'cls': 'configFile_nginxVd'},),
    csCmnd("configFileUpdate", pars={'cls': 'configFile_nginxVd', 'runAs': 'root'},),
    csCmnd("webVd_enable",),
    csCmnd("webVd_verify",),
    csCmnd("webVd_resolve",),
    csCmnd("webVd_fqdnPing",),
]

csCmndsList_seedInfo.setup(
    csCmndsList=csCmndsList,
)
