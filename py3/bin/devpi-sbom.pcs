#!/usr/bin/env python

""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.devpi/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
devpi-sbom.pcs: software bill of materials of the devpi hereWeb capability --- devpi-server with
devpi-web, a Python package index with a web UI, minimal: no PyPI mirror, 4 threads.
Debian does not package it. It is installed into an isolated venv of its own
(/bisos/venv/py3/isolated/devpiServer, its whole resolved set hash-pinned), because devpi-server
requires an older setuptools than asc has (reason in devpiInfo.venv).
Logins: root / devpi and admin / devpi (the rawBisos convention; insecure by design).
This is the server only. The usage side (devpi-client) is devpiUsage-sbom.pcs, which this sbom does
not pull in; devpiCbs-sbom.pcs, the sbom of devpi-cbs.pcs, runs both.
#+end_org """

from bisos import b
from bisos.b import cs
from bisos.b import b_io

from bisos.sbom import pkgsSeed  # pkgsSeed.plantWithWhich("seedSbom.cs")
from bisos.banna import sysAccts
from bisos.devpi.devpiInfo import (
    devpiInfo, venvSetupScript, initScript, envFileContent, accountsScriptContent,
)

ap = pkgsSeed.aptPkg

# The facts of the installation --- account, venv, pins, paths, env file, port, logins --- come
# from bisos.devpi.devpiInfo, the one source the units, devpiAdmin.cs, dns and vhost read too.
#
# Each func-bearing pseudo-package below is registered in aptPkgsList, so sbom_csu's
# aptPkgs_update() calls it instead of apt-get install. Its gate can never be true --- so each
# runs on *every* sbom_fullUpdate and must stay idempotent. Ordering is load-bearing.
# The Python packages are not in pipPkgsList: bisos.sbom ignores versions there (AI-Outputs.org).


def _bash(script: str) -> b.op.Outcome:
    outcome = b.subProc.WOpW(invedBy=None, log=1).bash(script)
    if outcome.isProblematic():
        b_io.eh.badOutcome(outcome)
    return outcome


def devpiAcctSetup():
    """The devpi system account and the dirs it must own. Not an apt package."""
    i = devpiInfo
    return _bash(f"""
set -e
{sysAccts.useraddScript(i.acctName)}

sudo mkdir -p {i.dataDir} {i.confDir}
sudo chown {i.acctName}:{i.acctName} {i.dataDir}
sudo chmod 750 {i.dataDir}
""")


def devpiVenvSetup():
    """devpi-server, devpi-web and their resolved set, hash-pinned, into the isolated venv. Not an apt package."""
    return _bash(venvSetupScript())


def devpiConfSetup():
    """The EnvironmentFile, the server directory (devpi-init, once) and the accounts script. Not an apt package.

    The EnvironmentFile is written only when absent (devpiAdmin.cs -i driftCheck reports how it
    differs). The accounts script is code: rewritten every run.
    """
    i = devpiInfo
    return _bash(f"""
set -e
if [ ! -f {i.envFile} ] ; then
    sudo tee {i.envFile} >/dev/null <<'DEVPI_ENV_EOF'
{envFileContent()}DEVPI_ENV_EOF
fi
sudo chown root:{i.acctName} {i.envFile}
sudo chmod 640 {i.envFile}
{initScript()}
sudo tee {i.accountsScript} >/dev/null <<'DEVPI_ACCTS_EOF'
{accountsScriptContent()}DEVPI_ACCTS_EOF
sudo chown root:{i.acctName} {i.confDir} {i.accountsScript}
sudo chmod 750 {i.confDir}
sudo chmod 640 {i.accountsScript}
""")


aptPkgsList = [
    ap("devpiAcctSetup", func=devpiAcctSetup),
    ap("devpiVenvSetup", func=devpiVenvSetup),
    ap("devpiConfSetup", func=devpiConfSetup),     # after the venv: devpi-init comes from it
]

pkgsSeed.setup(
    aptPkgsList=aptPkgsList,
)


####+BEGIN: b:py3:cs:cmnd/classHead :cmndName "readme" :extent "verify" :comment "Describe" :parsMand "" :parsOpt "" :argsMin 0 :argsMax 0 :pyInv ""
""" #+begin_org
*  _[[elisp:(blee:menu-sel:outline:popupMenu)][±]]_ _[[elisp:(blee:menu-sel:navigation:popupMenu)][Ξ]]_ [[elisp:(outline-show-branches+toggle)][|=]] [[elisp:(bx:orgm:indirectBufOther)][|>]] *[[elisp:(blee:ppmm:org-mode-toggle)][|N]]*  CmndSvc-   [[elisp:(outline-show-subtree+toggle)][||]] <<readme>>  *Describe*  =verify= ro=cli   [[elisp:(org-cycle)][| ]]
#+end_org """
class readme(cs.Cmnd):
    cmndParamsMandatory = [ ]
    cmndParamsOptional = [ ]
    cmndArgsLen = {'Min': 0, 'Max': 0,}

    @cs.track(fnLoc=True, fnEntry=True, fnExit=True)
    def cmnd(self,
             rtInv: cs.RtInvoker,
             cmndOutcome: b.op.Outcome,
    ) -> b.op.Outcome:
        """Describe"""
        failed = b_io.eh.badOutcome
        callParamsDict = {}
        if self.invocationValidate(rtInv, cmndOutcome, callParamsDict, None).isProblematic():
            return failed(cmndOutcome)
####+END:
        i = devpiInfo
        descriptionStr = f"""\
** Scope: devpi-server {i.devpiServerVersion} with devpi-web {i.devpiWebVersion}, minimal (no PyPI
   mirror, {i.threads} threads), browsed as {i.baseUrl}
   Logins: root / {i.rootPassword}, {i.adminUser} / {i.adminPassword}  (rawBisos convention; insecure)

** What this installs:
  1) devpiAcctSetup: the {i.acctName} system account, with uid/gid
     {sysAccts.sysAcctOf(i.acctName).uid} from bisos.banna.sysAccts, and {i.dataDir}.
  2) devpiVenvSetup: {len(i.reqs)} packages, each hash-pinned, into the isolated venv
     {i.venv} ({i.reqsArch} only). Isolated: devpi-server needs setuptools<=81.
  3) devpiConfSetup: {i.envFile} (only when absent); devpi-init of {i.serverDir}
     (only once: --no-root-pypi, root's password); {i.accountsScript}.

** After the units start, the devpi-accounts oneshot unit creates {i.adminUser} and its index
   {i.index} (if absent). Only root and {i.adminUser} may create users and indexes.

** Listener (loopback; port from bisos.banna):
     devpi  {i.localUrl}   (nginx: {i.baseUrl})

** What this does NOT do:
  - It does not start anything: devpi-cbs.pcs declares the devpi and devpi-accounts units.
  - It installs nothing for clients: that is devpiUsage-sbom.pcs (devpi-client).
  - It creates no PyPI mirror (root/pypi): a real devpi does that, typically in a dedicated VM.

       devpi-sbom.pcs -i sbom_fullUpdate\
"""
        print(descriptionStr)

        return cmndOutcome.set(
            opError=b.op.OpError.Success,
            opResults=None,
        )


def examples_csu() -> b.op.Outcome:
    """Common Usage Examples for this Command-Service Unit"""

    cmnd = cs.examples.cmndEnter
    literal = cs.examples.execInsert
    i = devpiInfo

    cmndOutcome = b.op.Outcome()

    cs.examples.menuChapter('*devpi -- sbom Examples*')
    cmnd('readme', comment=" # An overview short description")

    cs.examples.menuChapter('*Installation*')
    literal("devpi-sbom.pcs -i sbom_fullUpdate")

    cs.examples.menuChapter('*Verify Installation*')
    literal(f"{i.venvBin('devpi-server')} --version")
    literal(f"{i.venvBin('pip')} check")
    literal(f"sudo ls -la {i.serverDir}")

    cs.examples.menuChapter('*End-Of devpi -- sbom Examples*')
    return cmndOutcome
